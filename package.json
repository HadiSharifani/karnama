{
  "name": "karnama",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Persian work journal for Windows",
  "author": "Karnama Project",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "build": "npm run build:app && electron-builder --dir",
    "package:win": "npm run build:app && electron-builder --win nsis",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "better-sqlite3": "13.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jalaali-js": "2.0.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.8",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
